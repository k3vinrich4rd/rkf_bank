MYSQL_USER=usuario-do-banco
MYSQL_PASSWORD=senha-do-banco
MYSQL_DATABASE=rkfbank
MYSQL_PORT=5441
MYSQL_VERSION=8.4
MYSQL_ROOT_PASSWORD=senha-root-do-banco

# Login (JWT). Obrigatorio: sem ele a API nao sobe. Minimo 32 bytes; gere com: openssl rand -base64 48
# Quem tem este segredo emite token de qualquer usuario: nunca commite o valor real.
JWT_SEGREDO=troque-por-um-valor-aleatorio-com-pelo-menos-32-bytes
# Validade do token (opcional, padrao 15m). Ex.: 15m, 1h.
JWT_EXPIRACAO=15m

# Primeiro ADMIN (opcional). Criado na subida da API se os dois estiverem preenchidos e ele ainda nao existir.
ADMIN_CPF=
ADMIN_SENHA=

# Origens que podem chamar a API direto do navegador (CORS), separadas por virgula. Opcional: padrao http://localhost:3000.
# O frontend local passa pelo proxy do Next e nao precisa disto.
# CORS_ORIGENS=https://rkfbank.exemplo.com

# LGPD: por quanto tempo o cadastro encerrado pelo titular fica guardado antes de ser anonimizado. Opcional: padrao 5y
# (Lei 9.613/1998, art. 10). Formato: 5y, 60m, 1825d.
# LGPD_RETENCAO=5y

# Login das contas da equipe (Fellipe = origem, Renan = destino), criadas pelo db/seed/equipe. Opcional.
# Minimo 12 bytes. O valor real esta no guia privado da equipe (.equipe/, fora do Git): nunca commite.
# Vazio = as contas existem, mas ninguem entra nelas.
EQUIPE_SENHA=
